# Anthropic API key for AI features
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# ElevenLabs API key for transcript text-to-speech
# Get your key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional ElevenLabs voice/model settings
# If ELEVENLABS_VOICE_ID is unset, the backend searches default voices by ELEVENLABS_VOICE_NAME.
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NAME=Rachel
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
